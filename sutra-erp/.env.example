# SutraERP — Environment Configuration
# Copy this file to .env and fill in the values.

# Database
DATABASE_URL=postgres://sutraerp:sutraerp@localhost:5432/sutraerp

# Redis
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=3000

# Auth — HS256 signing secret for JWTs (REQUIRED; auth fails closed without it)
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Logging
RUST_LOG=info,sutra_erp=debug
